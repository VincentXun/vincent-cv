  </office:font-face-decls>
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:paragraph-properties style:writing-mode="lr-tb"/>
      <style:text-properties style:font-name="LiberationSans" style:font-name-asian="NotoSans" fo:font-size="10pt" style:font-size-asian="10pt" fo:language="en" fo:country="US" style:language-asian="zh" style:country-asian="CN"/>
    </style:default-style>
    <style:style style:name="Base" style:family="paragraph">
      <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.025cm" fo:line-height="109%" fo:orphans="2" fo:widows="2"/>
      <style:text-properties style:font-name="LiberationSans" style:font-name-asian="NotoSans" fo:font-size="10pt" style:font-size-asian="10pt"/>
    </style:style>
    <style:style style:name="Name" style:family="paragraph" style:parent-style-name="Base">
      <style:paragraph-properties fo:margin-bottom="0.04cm" fo:line-height="100%"/>
