    <style:page-layout style:name="PL1">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="0.60cm" fo:margin-bottom="0.30cm" fo:margin-left="1.35cm" fo:margin-right="1.35cm" style:writing-mode="lr-tb"/>
    </style:page-layout>
    <text:list-style style:name="BulletList">
      <text:list-level-style-bullet text:level="1" text:bullet-char="•">
        <style:list-level-properties text:space-before="0.46cm" text:min-label-width="0.34cm"/>
      </text:list-level-style-bullet>
    </text:list-style>
