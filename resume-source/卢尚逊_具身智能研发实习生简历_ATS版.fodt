  <office:meta>
    <dc:title>卢尚逊｜具身智能研发实习生简历（ATS版）</dc:title>
    <dc:creator>卢尚逊</dc:creator>
  </office:meta>
  <office:font-face-decls>
    <style:font-face style:name="NotoSans" svg:font-family="Noto Sans CJK SC" style:font-family-generic="system" style:font-pitch="variable" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"/>
